<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".RedfaceApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Redface2">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="forum.hardware.fr"
                    android:path="/forum1.php" />
                <data
                    android:scheme="https"
                    android:host="forum.hardware.fr"
                    android:path="/forum2.php" />
                <data
                    android:scheme="https"
                    android:host="forum.hardware.fr"
                    android:path="/forum1f.php" />
                <data
                    android:scheme="http"
                    android:host="forum.hardware.fr"
                    android:path="/forum1.php" />
                <data
                    android:scheme="http"
                    android:host="forum.hardware.fr"
                    android:path="/forum2.php" />
                <data
                    android:scheme="http"
                    android:host="forum.hardware.fr"
                    android:path="/forum1f.php" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="forum.hardware.fr"
                    android:pathPrefix="/hfr/" />
                <data
                    android:scheme="http"
                    android:host="forum.hardware.fr"
                    android:pathPrefix="/hfr/" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LauncherIconRestartActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:process=":launcherIconRestart"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity-alias
            android:name=".LauncherClassic"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherRf1"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rf1"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_rf1_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherMonogram"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monogram"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_monogram_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBubbles"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bubbles"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_bubbles_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherChip"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_chip"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_chip_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Retained so a 0.54.0 installation can repair an enabled historical alias on startup. -->
        <activity-alias
            android:name=".LauncherDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_dark_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherRose"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_rose"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_rose_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherRed"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_red"
            android:label="${appLabel}"
            android:roundIcon="@mipmap/ic_launcher_red_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
