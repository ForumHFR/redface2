.codex
tmp/
scripts/phase-minus-1-dashboard.sh
# Archived prompt drafts (mergées / fermées) — gardés localement pour référence
# historique mais hors versionnement. Les drafts actifs au top-level de drafts/
# restent visibles dans `git status` pour rappel.
drafts/ARCHIVED/
.gradle/
.gradle-user/
.gradle-tmp/
.kotlin/
local.properties
**/build/
core/parser/src/test/resources/fixtures/*_files/

# Stamped binaries produced by ./gradlew :app:bundleRelease + signing init-script,
# or by the dogfood debug build — never tracked in git, always uploaded to Play
# Console / shared out-of-band.
*.apk
*.aab

# Debug-only canonical key INTENTIONALLY committed (stable `adb install -r` across envs, BUILD-03).
# Future-proof against a `*.keystore`/`*.jks` rule being added later.
!config/signing/redface2-debug.keystore
